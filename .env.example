APP_NAME="Atom"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Serve public/ through PHP. Leave false when a web server serves static files.
SERVE_PUBLIC_ASSETS=false
# max-age for those assets; raise only if filenames are content-hashed.
ASSET_CACHE_MAX_AGE=0

# Comma-separated proxy addresses whose X-Forwarded-* headers are believed.
# Literal IPs or CIDR blocks (10.0.0.0/8). EMPTY = trust nothing, which is correct
# unless the app is genuinely behind a proxy. Anything listed here can set the
# client IP, host and scheme your app sees.
TRUSTED_PROXIES=

# Comma-separated Host allowlist. Empty disables the check; set it in production
# so a poisoned Host can't reach generated URLs, emails or password-reset links.
TRUSTED_HOSTS=

FILESYSTEM_DISK=public

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_ADAPTER=mysql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE="atom"
DB_USERNAME="root"
DB_PASSWORD="password"

# BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME="username"
MAIL_PASSWORD="password"
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="from@mail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

## Change this disk to s3 if you want to use s3 media drivers
MEDIA_DISK=public

COOKIE_CONSENT_ENABLED=true

## LogViewer Configuration
LOGVIEWER_PATTERN="*.log"
